# Postgres + Redis, provisioned by docker-compose.yml (`docker-compose up -d`
# from the repo root). Required — assigned-seat holds need both: Postgres
# is the durable AVAILABLE/BOOKED/BLOCKED state, Redis holds the
# short-lived per-seat TTL locks while someone's mid-checkout.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/thunderstream?schema=public"
REDIS_URL="redis://localhost:6379"
# How long a seat stays held for one buyer before it's released back to
# everyone else.
HOLD_TTL_SECONDS=600
PORT=4000

# Auth
JWT_SECRET="change-me-to-a-long-random-string-in-production"
SEED_OWNER_EMAIL="admin@thunderstreammedia.com"
SEED_OWNER_PASSWORD="changeme123"

# --- Integrations ---
# Every integration below runs in mock mode by default (ENABLED unset or
# not "true", or credentials missing): the full business flow still runs
# end-to-end, but no real external API call is made — a realistic fake
# response is logged and returned instead. Set the *_ENABLED flag plus
# its credentials to switch that one integration to live calls; nothing
# else needs to change.

# Zoom Server-to-Server OAuth (https://marketplace.zoom.us — create a
# Server-to-Server OAuth app under a Zoom account with API access)
ZOOM_ENABLED=false
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Microsoft Teams / Graph API (Azure AD app registration with
# OnlineMeetings.ReadWrite application permission)
TEAMS_ENABLED=false
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Webex Meetings REST API (webexapis.com developer integration)
WEBEX_ENABLED=false
WEBEX_ACCESS_TOKEN=

# WhatsApp Business Platform API (Meta Business account + WhatsApp
# Business Platform, requires business verification + approved templates)
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# SendGrid transactional email
EMAIL_ENABLED=false
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL="no-reply@thunderstreammedia.com"

# Razorpay (ticket payments)
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google Calendar sync — standard OAuth "Connect Google Calendar" flow
# (Admin → Settings → Connect button), not a service account key (many
# Google Workspace/Cloud orgs block service-account key creation via the
# iam.disableServiceAccountKeyCreation policy; this sidesteps that
# entirely). Create an OAuth 2.0 Client ID (type: Web application) in
# Google Cloud Console → APIs & Services → Credentials, with an
# Authorized redirect URI matching GOOGLE_OAUTH_REDIRECT_URI below.
# The resulting refresh token is stored in the database (StudioConfig),
# not here — this section only needs the app's own client credentials.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:4000/api/admin/google-calendar/callback"
FRONTEND_URL="http://localhost:5173"

# GeoIP blocking (geoip-lite) and local media storage (multer) are real,
# not gated — no env vars or external accounts needed for either.
