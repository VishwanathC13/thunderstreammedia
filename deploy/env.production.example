# Copied to server/.env by setup-server.sh, which fills in DATABASE_URL and
# JWT_SECRET for you. Edit the rest with:  nano /srv/thunderstream/server/.env
# Anything left as *_ENABLED=false runs in mock mode (no real calls made).

DATABASE_URL="CHANGE_ME"
REDIS_URL="redis://127.0.0.1:6379"
HOLD_TTL_SECONDS=600
PORT=4000
JWT_SECRET="CHANGE_ME"

# Public address of the site. The API is served from the same domain.
FRONTEND_URL="https://thunderstreammedia.com"
BACKEND_URL="https://thunderstreammedia.com"

# Razorpay — switch to LIVE keys (rzp_live_...) once your account is activated.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# SendGrid — the sender must be verified (single sender or domain authentication).
EMAIL_ENABLED=false
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="thunderstreammedia@gmail.com"

# Google Calendar — add this exact redirect URI to your OAuth client in Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="https://thunderstreammedia.com/api/admin/google-calendar/callback"

# WhatsApp Business (Meta) — Callback URL in Meta:
#   https://thunderstreammedia.com/api/webhooks/whatsapp
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

ZOOM_ENABLED=false
TEAMS_ENABLED=false
WEBEX_ENABLED=false
